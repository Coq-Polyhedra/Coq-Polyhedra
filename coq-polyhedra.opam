opam-version: "2.0"
version: "dev"

synopsis: "A formalization of convex polyhedra in Rocq"
description: """
Coq-Polyhedra is a Mathematical Components-based formalization of convex
polyhedra.  This package installs the contents of the theories directory under
the logical Rocq namespace Polyhedra.
"""

maintainer: [
  "Xavier Allamigeon <xavier.allamigeon@inria.fr>"
]
authors: [
  "Xavier Allamigeon"
  "Ricardo D. Katz"
  "Pierre-Yves Strub"
]
license: "CECILL-B"
homepage: "https://github.com/Coq-Polyhedra/Coq-Polyhedra"
bug-reports: "https://github.com/Coq-Polyhedra/Coq-Polyhedra/issues"
dev-repo: "git+https://github.com/Coq-Polyhedra/Coq-Polyhedra.git"

depends: [
  "dune" {>= "3.21"}
  "rocq-core" {>= "9.1" & < "9.2~"}
  "rocq-stdlib"
  "rocq-hierarchy-builder" {>= "1.10"}
  "rocq-mathcomp-algebra" {>= "2.6" & < "2.7~"}
  "rocq-mathcomp-finmap" {>= "2.2"}
  "rocq-mathcomp-bigenough" {>= "1.0.4"}
]

build: [
  ["dune" "subst"] {dev}
  ["dune" "build" "-p" name "-j" jobs]
]
